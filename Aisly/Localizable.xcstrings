    "archivedLists.screen.empty.description": {
      "comment": "Empty-state description for the archived lists screen.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Archived lists keep items, values and state. Unarchive anytime."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Listas arquivadas mantêm itens, valores e estado. Desarquive quando quiser."
          }
        }
      }
    },
